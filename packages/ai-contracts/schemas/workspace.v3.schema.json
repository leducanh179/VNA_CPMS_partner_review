{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cpms:ai:workspace:3",
  "title": "CPMS AI workspace v3",
  "$defs": {
    "policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "agentEnabled": {
          "type": "boolean"
        },
        "libraryEnabled": {
          "type": "boolean"
        },
        "spreadsheetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{10,150}$|^$"
        },
        "allowedRootIds": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{10,150}$"
          }
        },
        "maxQuestions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "includeUnknownRights": {
          "type": "boolean"
        },
        "answerFormat": {
          "type": "string",
          "enum": [
            "CARDS",
            "TABLE"
          ]
        },
        "instructions": {
          "type": "string",
          "maxLength": 1500
        },
        "selectionRules": {
          "type": "string",
          "maxLength": 1000
        },
        "vision": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": false
            },
            "maxImagesPerRequest": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "monthlyLimitVnd": {
              "type": "number",
              "const": 0
            }
          },
          "required": [
            "enabled",
            "maxImagesPerRequest",
            "monthlyLimitVnd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "agentEnabled",
        "libraryEnabled",
        "spreadsheetId",
        "allowedRootIds",
        "maxQuestions",
        "maxResults",
        "includeUnknownRights",
        "answerFormat",
        "instructions",
        "selectionRules",
        "vision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "libraryEnabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "spreadsheetId": {
                "minLength": 10
              }
            }
          }
        }
      ]
    },
    "confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confirmed"
      ],
      "properties": {
        "action": {
          "enum": [
            "SAVE",
            "SAVE_AND_SUBMIT"
          ]
        },
        "confirmed": {
          "const": true
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 100
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          }
        }
      }
    },
    "libraryQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "mediaType"
      ],
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 120
        },
        "mediaType": {
          "enum": [
            "PHOTO",
            "VIDEO",
            "FOLDER",
            "ANY"
          ]
        }
      }
    }
  }
}
