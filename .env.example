# Copy to .env. This file contains development defaults only, never secrets.
DB_RUNTIME=DOCKER
POSTGRES_DB=cpms
POSTGRES_USER=cpms
POSTGRES_PASSWORD=cpms_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cpms:cpms_dev_only@localhost:5432/cpms?schema=public

API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://localhost:3000

AUTH_MODE=LOCAL_SESSION
ALLOW_OPEN_DEMO=false
LOCAL_DEMO_IMPERSONATION=false
LOCAL_DEMO_CREDENTIALS=false
LOCAL_DEMO_CREDENTIAL_FILE=
DEMO_ACTOR_ID=00000000-0000-4000-8000-000000000001
AI_MODE=OFF

# Google Sheets IV-B (server-side OAuth; leave secrets blank until configured)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PROVIDER_WRITES=BLOCKED
GOOGLE_OAUTH_CLIENT_SECRET=
# 32-byte key encoded as 64 hexadecimal characters or base64
GOOGLE_OAUTH_ENCRYPTION_KEY=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/integrations/google/callback

# Google Drive Campaign Workspace V (IDs are configuration, never OAuth credentials)
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_CAMPAIGN_PARENT_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_MODE=CPMS_VISIBILITY_ONLY
GOOGLE_DRIVE_SHARING_MODE=LINK_WRITER
GOOGLE_DRIVE_UPLOAD_MAX_BYTES=52428800
GOOGLE_DRIVE_RESUMABLE_THRESHOLD_BYTES=5242880
