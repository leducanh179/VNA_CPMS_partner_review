generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignLifecycleState {
  DRAFT
  SUBMITTED_TO_DEPARTMENT
  DEPARTMENT_ASSIGNED
  DIVISION_ASSIGNED
  CM_ACCEPTED
  PLANNING
  READY_TO_LAUNCH
  RUNNING
  PAUSE_REQUESTED
  PAUSED
  RESUME_REQUESTED
  CANCEL_REQUESTED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum CampaignNormalizationStatus {
  CURRENT
  NEEDS_NORMALIZATION
}

enum CampaignMarketSelectionOrigin {
  CUSTOM
  REGION
  GLOBAL
  LEGACY
}

enum OrganizationUnitCategory {
  QUICK_SELECT
  FOREIGN_BRANCH
}

enum CampaignCommentReactionType {
  LIKE
  DISLIKE
}

model Role {
  code        String      @id
  displayName String      @map("display_name")
  description String
  actorRoles  ActorRole[]
  scopedBindings ScopedRoleBinding[]
  permissionPresets RolePermission[]
  recordVersion Int @default(1) @map("record_version")
  presetInitialized Boolean @default(false) @map("preset_initialized")

  @@map("roles")
}

model Supplier {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  normalizedName String @unique @map("normalized_name")
  taxId String? @unique @map("tax_id")
  profile Json @db.JsonB
  isActive Boolean @default(true) @map("is_active")
  recordVersion Int @default(1) @map("record_version")
  contracts SupplyContract[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("suppliers")
}

model PersonalNote {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict)
  title String
  document Json @db.JsonB
  searchText String @map("search_text")
  color String @default("YELLOW")
  pinned Boolean @default(false)
  recordVersion Int @default(1) @map("record_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([actorId, pinned, title])
  @@map("personal_notes")
}

model DirectoryExternalIdentity {
  provider String
  externalId String @map("external_id")
  employeeCode String @map("employee_code")
  person PersonnelDirectoryEntry @relation(fields: [employeeCode], references: [employeeCode], onDelete: Restrict)
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)
  sourceUpdatedAt DateTime? @map("source_updated_at") @db.Timestamptz(3)
  @@id([provider, externalId])
  @@unique([provider, employeeCode])
  @@map("directory_external_identities")
}

model DirectorySyncRun {
  provider String
  batchId String @map("batch_id")
  digest String
  capturedAt DateTime @map("captured_at") @db.Timestamptz(3)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)
  actorId String @map("actor_id") @db.Uuid
  result Json @db.JsonB
  @@id([provider, batchId])
  @@map("directory_sync_runs")
}

model SupplyItemTerm {
  id String @id @default(uuid()) @db.Uuid
  contractId String @map("contract_id") @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  periodId String @map("period_id") @db.Uuid
  contract SupplyContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  slot SupplySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  period SupplyPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  baseline Json? @db.JsonB
  effective Json @db.JsonB
  recordVersion Int @default(1) @map("record_version")
  @@unique([slotId, periodId])
  @@map("supply_item_terms")
}

model Actor {
  initializedQcttPlans QcttPlan[] @relation("QcttPlanInitializer")
  createdQcttPlanItems QcttPlanItem[]
  qcttPlanItemRevisions QcttPlanItemRevision[]
  qcttPlanCommands QcttPlanCommand[]
  personalNotes PersonalNote[]
  campaignFormDrafts CampaignFormDraft[]
  materialFormDrafts MaterialFormDraft[]
  contractFormDrafts ContractFormDraft[]
  gridDrafts GridDraft[]
  supplyPivotViews SupplyPivotView[]
  createdBookings BookingRecord[]
  bookingRevisions BookingRevision[]
  managedSupplyContracts SupplyContract[] @relation("SupplyManager")
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique
  displayName String       @map("display_name")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       ActorRole[]
  campaigns   Campaign[]   @relation("CampaignCreatedBy")
  deletedCampaigns Campaign[] @relation("CampaignDeletedBy")
  auditEvents AuditEvent[] @relation("AuditEffectiveActor")
  originalAuditEvents AuditEvent[] @relation("AuditOriginalActor")
  requestedCampaignChanges CampaignChangeRequest[] @relation("CampaignChangeRequester")
  decidedCampaignChanges CampaignChangeRequest[] @relation("CampaignChangeDecider")
  createdCampaignPlans CampaignPlan[]
  googleOAuthConnection GoogleOAuthConnection?
  googleOAuthStates GoogleOAuthState[]
  connectedDriveIntegrations GoogleDriveIntegrationConnection[]
  spreadsheetExchangeOperations SpreadsheetExchangeOperation[]
  campaignComments CampaignComment[] @relation("CampaignCommentAuthor")
  deletedCampaignComments CampaignComment[] @relation("CampaignCommentDeletedBy")
  campaignCommentReactions CampaignCommentReaction[]
  materialComments MaterialComment[]
  // LEGACY, PERSONNEL or PILOT_ADMIN; the SQL check keeps pilot admins unlinked to personnel.
  accountKind String @default("LEGACY") @map("account_kind")
  personnelEmployeeCode String? @unique @map("personnel_employee_code")
  loginEmail String? @unique @map("login_email")
  authzVersion Int @default(1) @map("authz_version")
  personnel PersonnelDirectoryEntry? @relation(fields: [personnelEmployeeCode], references: [employeeCode], onDelete: Restrict)
  credential LocalCredential?
  originalSessions LocalSession[] @relation("SessionOriginalActor")
  effectiveSessions LocalSession[] @relation("SessionEffectiveActor")
  employment EmploymentMembership?
  scopedBindings ScopedRoleBinding[]
  permissionOverrides AccountPermissionOverride[]
  participations CampaignParticipant[] @relation("CampaignParticipantActor")
  assignedParticipations CampaignParticipant[] @relation("CampaignParticipantAssigner")
  approvalPolicyVersions ApprovalPolicyVersion[]
  submittedWorkflowRevisions CampaignWorkflowRevision[]
  createdWorkflowSteps CampaignWorkflowStep[] @relation("WorkflowStepCreator")
  assignedWorkflowSteps CampaignWorkflowStep[] @relation("WorkflowStepAssignee")
  workflowDecisions CampaignWorkflowDecision[] @relation("WorkflowDecisionActor")
  originalWorkflowDecisions CampaignWorkflowDecision[] @relation("WorkflowDecisionOriginal")
  workflowAssignments CampaignWorkflowAssignment[] @relation("WorkflowAssignmentActor")
  assignedWorkflowAssignments CampaignWorkflowAssignment[] @relation("WorkflowAssignmentAssigner")
  sentCooperationRequests CampaignCooperationRequest[] @relation("CooperationRequester")
  targetedCooperationRequests CampaignCooperationRequest[] @relation("CooperationTarget")
  respondedCooperationRequests CampaignCooperationRequest[] @relation("CooperationResponder")
  workflowCommands CampaignWorkflowCommand[] @relation("WorkflowCommandActor")
  originalWorkflowCommands CampaignWorkflowCommand[] @relation("WorkflowCommandOriginal")

  @@map("actors")
}

model ActorRole {
  actorId  String   @map("actor_id") @db.Uuid
  roleCode String   @map("role_code")
  actor    Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  @@id([actorId, roleCode])
  @@index([roleCode])
  @@map("actor_roles")
}

model Campaign {
  qcttPlan QcttPlan?
  bookings BookingRecord[]
  id                      String                      @id @default(uuid()) @db.Uuid
  code                    String                      @unique
  name                    String
  requestingUnit          String?                     @map("requesting_unit")
  lifecycleState          CampaignLifecycleState      @default(DRAFT) @map("lifecycle_state")
  startDate               DateTime?                   @map("start_date") @db.Date
  endDate                 DateTime?                   @map("end_date") @db.Date
  effectiveStartDate      DateTime?                   @map("effective_start_date") @db.Date
  effectiveEndDate        DateTime?                   @map("effective_end_date") @db.Date
  levelCode               String?                     @map("level_code")
  requestingEmployeeCode  String?                     @map("requesting_employee_code")
  manualRequesterEmail    String?                     @map("manual_requester_email")
  primaryObjectiveCode    String?                     @map("primary_objective_code")
  primaryObjectiveOther   String?                     @map("primary_objective_other")
  kpiText                 String?                     @map("kpi_text")
  descriptionRichText     Json?                       @map("description_rich_text")
  additionalInformation   Json                        @default("[]") @map("additional_information")
  dataSchemaVersion       Int                         @default(1) @map("data_schema_version")
  normalizationStatus     CampaignNormalizationStatus @default(NEEDS_NORMALIZATION) @map("normalization_status")
  fieldValues             Json                        @default("{}") @map("field_values")
  recordVersion           Int                         @default(1) @map("record_version")
  deletedAt               DateTime?                   @map("deleted_at") @db.Timestamptz(3)
  deletedByActorId String?               @map("deleted_by_actor_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdByActorId String                @map("created_by_actor_id") @db.Uuid
  createdBy       Actor                  @relation("CampaignCreatedBy", fields: [createdByActorId], references: [id], onDelete: Restrict)
  deletedBy       Actor?                 @relation("CampaignDeletedBy", fields: [deletedByActorId], references: [id], onDelete: Restrict)
  level           CampaignLevel?         @relation(fields: [levelCode], references: [code], onDelete: Restrict)
  requestingEmployee PersonnelDirectoryEntry? @relation(fields: [requestingEmployeeCode], references: [employeeCode], onDelete: Restrict)
  primaryObjective CampaignObjective?    @relation(fields: [primaryObjectiveCode], references: [code], onDelete: Restrict)
  markets         CampaignMarket[]
  provinces       CampaignProvince[]
  requestingUnits CampaignRequestingUnit[]
  driveWorkspace  CampaignDriveWorkspace?
  comments        CampaignComment[]
  scopedRoleBindings ScopedRoleBinding[]
  permissionOverrides AccountPermissionOverride[]
  participants CampaignParticipant[]
  requestingDepartmentId String? @map("requesting_department_id") @db.Uuid
  requestingDivisionId String? @map("requesting_division_id") @db.Uuid
  requestingDepartment EmploymentOrgUnit? @relation("CampaignRequestingDepartment", fields: [requestingDepartmentId], references: [id], onDelete: Restrict)
  requestingDivision EmploymentOrgUnit? @relation("CampaignRequestingDivision", fields: [requestingDivisionId], references: [id], onDelete: Restrict)
  businessRevision Int @default(1) @map("business_revision")
  workflow CampaignWorkflow?
  approvalPolicyVersions ApprovalPolicyVersion[]
  workflowCommands CampaignWorkflowCommand[]

  @@index([lifecycleState])
  @@index([requestingUnit])
  @@index([levelCode])
  @@index([requestingEmployeeCode])
  @@index([primaryObjectiveCode])
  @@index([normalizationStatus])
  @@index([deletedAt, updatedAt])
  @@map("campaigns")
}

// Private, incomplete form state. It is not a Campaign and has no workflow or Drive side effects.
model CampaignFormDraft {
  id String @id @db.Uuid
  ownerActorId String @map("owner_actor_id") @db.Uuid
  owner Actor @relation(fields: [ownerActorId], references: [id], onDelete: Restrict)
  title String @default("")
  levelCode String? @map("level_code")
  formData Json @map("form_data") @db.JsonB
  recordVersion Int @default(1) @map("record_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerActorId, updatedAt])
  @@map("campaign_form_drafts")
}

// Actor-private spreadsheet buffer. Never contributes to supply, approvals or reporting.
model GridDraft {
  id String @id @default(uuid()) @db.Uuid
  ownerActorId String @map("owner_actor_id") @db.Uuid
  owner Actor @relation(fields: [ownerActorId], references: [id], onDelete: Restrict)
  scope String
  value Json @db.JsonB
  recordVersion Int @default(1) @map("record_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([ownerActorId, scope])
  @@map("grid_drafts")
}

// Private, incomplete Material input. It is not a MaterialRecord and is visible only to its creator.
model MaterialFormDraft {
  id String @id @db.Uuid
  ownerActorId String @map("owner_actor_id") @db.Uuid
  owner Actor @relation(fields: [ownerActorId], references: [id], onDelete: Restrict)
  materialId String? @map("material_id") @db.Uuid
  title String @default("")
  formData Json @map("form_data") @db.JsonB
  recordVersion Int @default(1) @map("record_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerActorId, updatedAt])
  @@map("material_form_drafts")
}

// Private, incomplete Contract or owned-channel input. Not an active supply contract.
model ContractFormDraft {
  id String @id @db.Uuid
  ownerActorId String @map("owner_actor_id") @db.Uuid
  owner Actor @relation(fields: [ownerActorId], references: [id], onDelete: Restrict)
  kind String
  title String @default("")
  activityCode String? @map("activity_code")
  formData Json @map("form_data") @db.JsonB
  recordVersion Int @default(1) @map("record_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerActorId, updatedAt])
  @@map("contract_form_drafts")
}

model CampaignDriveWorkspace {
  campaignId                 String   @id @map("campaign_id") @db.Uuid
  sharedDriveId              String   @map("shared_drive_id")
  parentFolderId             String   @map("parent_folder_id")
  campaignFolderId           String?  @unique @map("campaign_folder_id")
  campaignFolderLink         String?  @map("campaign_folder_link")
  lastKnownFolderName        String?  @map("last_known_folder_name")
  baseDocumentsFolderId      String?  @map("base_documents_folder_id")
  mediaAssetsFolderId        String?  @map("media_assets_folder_id")
  otherDocumentsFolderId     String?  @map("other_documents_folder_id")
  templateVersion            Int      @default(1) @map("template_version")
  accessMode                 String   @default("CPMS_VISIBILITY_ONLY") @map("access_mode")
  sharingMode                String   @default("PARENT_INHERITED") @map("sharing_mode")
  permissionPolicyVersion    Int      @default(1) @map("permission_policy_version")
  syncStatus                 String   @default("NOT_CREATED") @map("sync_status")
  lifecycleStatus            String   @default("ACTIVE") @map("lifecycle_status")
  lastCheckedAt              DateTime? @map("last_checked_at") @db.Timestamptz(3)
  lastErrorCode              String?  @map("last_error_code")
  lastErrorMessage           String?  @map("last_error_message")
  googlePermissionId         String?  @map("google_permission_id")
  desiredRole                String?  @map("desired_role")
  permissionSyncStatus       String?  @map("permission_sync_status")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaign                   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([syncStatus, updatedAt])
  @@index([lifecycleStatus, updatedAt])
  @@map("campaign_drive_workspaces")
}

model CampaignLevel {
  code            String     @id
  label           String
  ruleDescription String     @map("rule_description")
  displayOrder    Int        @map("display_order")
  isActive        Boolean    @default(true) @map("is_active")
  campaigns       Campaign[]

  @@map("campaign_levels")
}

model CampaignObjective {
  code              String     @id
  label             String
  requiresOtherText Boolean    @default(false) @map("requires_other_text")
  displayOrder      Int        @map("display_order")
  isActive          Boolean    @default(true) @map("is_active")
  campaigns         Campaign[]

  @@map("campaign_objectives")
}

model MarketRegion {
  code         String   @id
  name         String
  displayOrder Int      @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  markets      Market[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("market_regions")
}

model Market {
  supplySlots SupplySlot[]
  code             String             @id
  name             String
  regionCode       String             @map("region_code")
  displayOrder     Int                @map("display_order")
  isActive         Boolean            @default(true) @map("is_active")
  region           MarketRegion       @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  campaignMarkets  CampaignMarket[]
  organizationUnits OrganizationUnit[]
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([regionCode, isActive, displayOrder])
  @@map("markets")
}

model CampaignMarket {
  campaignId      String                        @map("campaign_id") @db.Uuid
  marketCode      String                        @map("market_code")
  selectionOrigin CampaignMarketSelectionOrigin @default(CUSTOM) @map("selection_origin")
  selectionCode   String?                       @map("selection_code")
  createdAt       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  campaign        Campaign                      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  market          Market                        @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@id([campaignId, marketCode])
  @@index([marketCode])
  @@map("campaign_markets")
}

model Province {
  code       String             @id
  name       String
  displayOrder Int              @map("display_order")
  isActive   Boolean            @default(true) @map("is_active")
  campaigns  CampaignProvince[]

  @@map("provinces")
}

model CampaignProvince {
  campaignId String   @map("campaign_id") @db.Uuid
  provinceCode String @map("province_code")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  province   Province @relation(fields: [provinceCode], references: [code], onDelete: Restrict)

  @@id([campaignId, provinceCode])
  @@index([provinceCode])
  @@map("campaign_provinces")
}

model OrganizationUnit {
  supplyContracts SupplyContract[]
  supplyAllocations SupplyAllocation[]
  code           String                   @id
  displayName    String                   @map("display_name")
  sourceName     String?                  @map("source_name")
  category       OrganizationUnitCategory
  sourceProvider String                   @map("source_provider")
  sourceUnitId   String?                  @unique @map("source_unit_id")
  sourceUnitCode String?                  @map("source_unit_code")
  marketCode     String?                  @map("market_code")
  displayOrder   Int                      @map("display_order")
  isActive       Boolean                  @default(true) @map("is_active")
  market         Market?                  @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  campaigns      CampaignRequestingUnit[]
  employmentMappings EmploymentOrgUnit[]
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category, isActive, displayOrder])
  @@index([marketCode])
  @@map("organization_units")
}

model CampaignRequestingUnit {
  id                   String            @id @default(uuid()) @db.Uuid
  campaignId           String            @map("campaign_id") @db.Uuid
  organizationUnitCode String?           @map("organization_unit_code")
  customName           String?           @map("custom_name")
  displayOrder         Int               @default(0) @map("display_order")
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organizationUnit     OrganizationUnit? @relation(fields: [organizationUnitCode], references: [code], onDelete: Restrict)

  @@unique([campaignId, organizationUnitCode])
  @@index([organizationUnitCode])
  @@map("campaign_requesting_units")
}

model PersonnelDirectoryEntry {
  externalIdentities DirectoryExternalIdentity[]
  supplyBookers SupplySlotBooker[]
  employeeCode       String     @id @map("employee_code")
  fullName           String     @map("full_name")
  gender             String?
  organizationCode   String?    @map("organization_code")
  organizationName   String     @map("organization_name")
  departmentName     String?    @map("department_name")
  jobTitle           String?    @map("job_title")
  phoneText          String?    @map("phone_text")
  email              String?
  gmailEmail         String?    @map("gmail_email")
  birthYear          Int?       @map("birth_year")
  birthDate          DateTime?  @map("birth_date") @db.Date
  sourceProvider     String     @map("source_provider")
  isActive           Boolean    @default(true) @map("is_active")
  requestedCampaigns Campaign[]
  account Actor?
  displayGroup String? @map("display_group")
  sourceReference String? @map("source_reference")
  recordVersion Int @default(1) @map("record_version")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([fullName])
  @@index([email])
  @@index([organizationCode, departmentName])
  @@map("personnel_directory_entries")
}

model ContentPillar {
  code           String          @id
  label          String
  year           Int
  level          Int
  parentCode     String?         @map("parent_code")
  effectiveStart DateTime?       @map("effective_start") @db.Date
  effectiveEnd   DateTime?       @map("effective_end") @db.Date
  isActive       Boolean         @default(true) @map("is_active")
  parent         ContentPillar?  @relation("ContentPillarTree", fields: [parentCode], references: [code], onDelete: Restrict)
  children       ContentPillar[] @relation("ContentPillarTree")

  @@index([year, level, isActive])
  @@index([parentCode])
  @@map("content_pillars")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      Actor    @relation("AuditEffectiveActor", fields: [actorId], references: [id], onDelete: Restrict)
  originalActor Actor? @relation("AuditOriginalActor", fields: [originalActorId], references: [id], onDelete: Restrict)
  originalActorId String? @map("original_actor_id") @db.Uuid
  contextMode String? @map("context_mode")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model CampaignComment {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  authorActorId    String   @map("author_actor_id") @db.Uuid
  body             String
  parentCommentId  String?  @map("parent_comment_id") @db.Uuid
  replyToCommentId String?  @map("reply_to_comment_id") @db.Uuid
  recordVersion    Int      @default(1) @map("record_version")
  editedAt         DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedByActorId String?  @map("deleted_by_actor_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author           Actor    @relation("CampaignCommentAuthor", fields: [authorActorId], references: [id], onDelete: Restrict)
  deletedBy        Actor?   @relation("CampaignCommentDeletedBy", fields: [deletedByActorId], references: [id], onDelete: Restrict)
  parent           CampaignComment? @relation("CampaignCommentReplies", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies          CampaignComment[] @relation("CampaignCommentReplies")
  replyTo          CampaignComment? @relation("CampaignCommentReplyTargets", fields: [replyToCommentId], references: [id], onDelete: Restrict)
  replyTargets     CampaignComment[] @relation("CampaignCommentReplyTargets")
  reactions        CampaignCommentReaction[]

  @@index([campaignId, parentCommentId, createdAt])
  @@index([authorActorId, createdAt])
  @@index([deletedAt])
  @@map("campaign_comments")
}

model CampaignCommentReaction {
  id        String                      @id @default(uuid()) @db.Uuid
  commentId String                      @map("comment_id") @db.Uuid
  actorId   String                      @map("actor_id") @db.Uuid
  type      CampaignCommentReactionType
